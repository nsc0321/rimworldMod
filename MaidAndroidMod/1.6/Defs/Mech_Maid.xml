<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ==================== Abstract Maid Mechanoid Base (ThingDef) ==================== -->
  <ThingDef ParentName="LightMechanoid" Name="Mech_Maid_Base" Abstract="True">
    <race>
      <body>Mech_Light</body> <!-- Use stable vanilla Mech_Light body to guarantee PawnRenderTree initialization! -->
      <mechWeightClass>Light</mechWeightClass>
      <baseBodySize>1.0</baseBodySize>
      <mechFixedSkillLevel>10</mechFixedSkillLevel>
      <baseHealthScale>1.6</baseHealthScale>
      <lifeStageAges>
        <li>
          <def>MechanoidFullyFormed</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>MechanoidFullyFormed</def>
          <minAge>100</minAge>
        </li>
      </lifeStageAges>
      <mechEnabledWorkTypes>
        <li>Cleaning</li>
        <li>Hauling</li>
        <li>Cooking</li>
        <li>Growing</li>
        <li>Crafting</li>
        <li>Mining</li>
        <li>Construction</li>
        <li>Art</li>
        <li>Warden</li>
        <li>Research</li>
        <li>Doctor</li>
        <li>Firefighter</li>
        <li>Handling</li>
        <li>Hunting</li>
        <li>PlantCutting</li>
        <li>Smithing</li>
        <li>Tailoring</li>
        <li MayRequire="Ludeon.RimWorld.Biotech">Childcare</li>
        <li MayRequire="Ludeon.RimWorld.Anomaly">DarkStudy</li>
      </mechEnabledWorkTypes>
    </race>
    <comps>
      <li Class="MaidAndroidMod.CompProperties_MaidSkin"/>
    </comps>
  </ThingDef>

  <!-- ==================== 1. Basic Maid Mechanoid ==================== -->
  <ThingDef ParentName="Mech_Maid_Base">
    <defName>Mech_Maid_Basic</defName>
    <label>basic maid mechanoid</label>
    <description>A basic-tier domestic utility mechanoid. Designed to handle cleaning and hauling by default, and can accept up to 2 memory modules to perform other domestic tasks.</description>
    <statBases>
      <MarketValue>800</MarketValue>
      <MoveSpeed>2.8</MoveSpeed>
      <BandwidthCost MayRequire="Ludeon.RimWorld.Biotech">2</BandwidthCost>
      <WorkSpeedGlobal>0.8</WorkSpeedGlobal>
      <ArmorRating_Sharp>0.20</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.10</ArmorRating_Blunt>
      <ArmorRating_Heat>2.00</ArmorRating_Heat>
    </statBases>
  </ThingDef>

  <!-- ==================== 2. Standard Maid Mechanoid ==================== -->
  <ThingDef ParentName="Mech_Maid_Base">
    <defName>Mech_Maid_Standard</defName>
    <label>standard maid mechanoid</label>
    <description>A standard-tier domestic utility mechanoid. Equipped with improved joint motors and can accept up to 3 memory modules to perform various tasks.</description>
    <statBases>
      <MarketValue>1200</MarketValue>
      <MoveSpeed>3.0</MoveSpeed>
      <BandwidthCost MayRequire="Ludeon.RimWorld.Biotech">2</BandwidthCost>
      <WorkSpeedGlobal>1.0</WorkSpeedGlobal>
      <ArmorRating_Sharp>0.28</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.13</ArmorRating_Blunt>
      <ArmorRating_Heat>2.00</ArmorRating_Heat>
    </statBases>
  </ThingDef>

  <!-- ==================== 3. High Maid Mechanoid ==================== -->
  <ThingDef ParentName="Mech_Maid_Base">
    <defName>Mech_Maid_High</defName>
    <label>high-performance maid mechanoid</label>
    <description>A high-performance domestic utility mechanoid. Built with resilient external casing and advanced processors, allowing up to 4 memory modules.</description>
    <statBases>
      <MarketValue>1800</MarketValue>
      <MoveSpeed>3.5</MoveSpeed>
      <BandwidthCost MayRequire="Ludeon.RimWorld.Biotech">2</BandwidthCost>
      <WorkSpeedGlobal>1.2</WorkSpeedGlobal>
      <ArmorRating_Sharp>0.32</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.18</ArmorRating_Blunt>
      <ArmorRating_Heat>2.00</ArmorRating_Heat>
    </statBases>
  </ThingDef>

  <!-- ==================== 4. Ultra Maid Mechanoid ==================== -->
  <ThingDef ParentName="Mech_Maid_Base">
    <defName>Mech_Maid_Ultra</defName>
    <label>ultra-performance maid mechanoid</label>
    <description>An ultra-tier domestic mechanoid of exceptional craft. Outfitted with premium plasteel casing, gold-plated connectors, and can support up to 5 concurrent memory modules.</description>
    <statBases>
      <MarketValue>2600</MarketValue>
      <MoveSpeed>3.8</MoveSpeed>
      <BandwidthCost MayRequire="Ludeon.RimWorld.Biotech">2</BandwidthCost>
      <WorkSpeedGlobal>1.3</WorkSpeedGlobal>
      <ArmorRating_Sharp>0.40</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.20</ArmorRating_Blunt>
      <ArmorRating_Heat>2.00</ArmorRating_Heat>
    </statBases>
  </ThingDef>

  <!-- ==================== Legacy Fallback Mech_Maid ==================== -->
  <ThingDef ParentName="Mech_Maid_Base">
    <defName>Mech_Maid</defName>
    <label>maid mechanoid (legacy)</label>
    <description>A legacy maid mechanoid from previous mod versions. Provided for save compatibility.</description>
    <statBases>
      <MarketValue>1200</MarketValue>
