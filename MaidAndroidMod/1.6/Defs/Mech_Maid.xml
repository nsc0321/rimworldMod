      <BandwidthCost MayRequire="Ludeon.RimWorld.Biotech">2</BandwidthCost>
      <WorkSpeedGlobal>1.0</WorkSpeedGlobal>
      <ArmorRating_Sharp>0.28</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.13</ArmorRating_Blunt>
      <ArmorRating_Heat>2.00</ArmorRating_Heat>
    </statBases>
  </ThingDef>


  <!-- ==================== PawnKindDefs ==================== -->
  <PawnKindDef ParentName="LightMechanoidKind" Name="Mech_Maid_KindBase" Abstract="True">
    <combatPower>40</combatPower>
    <defaultFactionType>PlayerColony</defaultFactionType>
    <allowInMechClusters>false</allowInMechClusters>
    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Mechanoid/Mech_Maid/Mech_Maid</texPath>
          <shaderType>Cutout</shaderType>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>1.95</drawSize>
          <shadowData>
            <volume>(0.4, 0.4, 0.4)</volume>
          </shadowData>
        </bodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Mechanoid/Mech_Maid/Mech_Maid</texPath>
          <shaderType>Cutout</shaderType>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>1.95</drawSize>
          <shadowData>
            <volume>(0.4, 0.4, 0.4)</volume>
          </shadowData>
        </bodyGraphicData>
      </li>
    </lifeStages>
  </PawnKindDef>

  <PawnKindDef ParentName="Mech_Maid_KindBase">
    <defName>Mech_Maid_Basic</defName>
    <label>basic maid mechanoid</label>
    <race>Mech_Maid_Basic</race>
  </PawnKindDef>

  <PawnKindDef ParentName="Mech_Maid_KindBase">
