    <race>Mech_Maid_Ultra</race>
  </PawnKindDef>

  <PawnKindDef ParentName="Mech_Maid_KindBase">
    <defName>Mech_Maid</defName>
    <label>maid mechanoid (legacy)</label>
    <race>Mech_Maid</race>
  </PawnKindDef>


  <!-- ==================== Gestation Recipes ==================== -->

  <!-- 1. Gestate Basic Maid -->
  <RecipeDef ParentName="LightMechanoidRecipe">
    <defName>Gestate_Mech_Maid_Basic</defName>
    <label>gestate basic maid mechanoid</label>
    <description>Gestate a basic maid mechanoid in a gestation vat.</description>
    <recipeUsers Inherit="False">
      <li>MechGestator</li>
    </recipeUsers>
    <products>
      <Mech_Maid_Basic>1</Mech_Maid_Basic>
    </products>
    <ingredients Inherit="False">
      <li>
        <filter><thingDefs><li>SubcoreBasic</li></thingDefs></filter>
        <count>1</count>
      </li>
      <li>
        <filter><thingDefs><li>Steel</li></thingDefs></filter>
        <count>120</count>
      </li>
      <li>
        <filter><thingDefs><li>ComponentIndustrial</li></thingDefs></filter>
        <count>4</count>
      </li>
    </ingredients>
    <gestationCycles>3</gestationCycles>
    <researchPrerequisite>BasicMechtech</researchPrerequisite>
    <descriptionHyperlinks>
      <ThingDef>Mech_Maid_Basic</ThingDef>
    </descriptionHyperlinks>
  </RecipeDef>

