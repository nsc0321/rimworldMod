<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- ==================== Maid Appearance Modification Station (BuildingDef) ==================== -->
  <ThingDef ParentName="BenchBase">
    <defName>MaidAppearanceStation</defName>
    <label>maid appearance station</label>
    <description>A mechanical paint-spraying and customization station designed to tune the exterior casings and skins of maid mechanoids.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Things/Building/Production/MaidAppearanceStation</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3.5, 2.5)</drawSize>
    </graphicData>
    <castEdgeShadows>true</castEdgeShadows>
    <staticSunShadowHeight>0.20</staticSunShadowHeight>
    <costList>
      <Steel>150</Steel>
      <ComponentIndustrial>5</ComponentIndustrial>
      <Plasteel>20</Plasteel>
    </costList>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>
    <altitudeLayer>Building</altitudeLayer>
    <fillPercent>0.5</fillPercent>
    <useHitPoints>true</useHitPoints>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <WorkToBuild>1800</WorkToBuild>
      <Flammability>0.5</Flammability>
      <Mass>35</Mass>
    </statBases>
    <size>(3,2)</size>
    <designationCategory>Biotech</designationCategory>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <surfaceType>Item</surfaceType>
    <researchPrerequisites>
      <li>BasicMechtech</li>
    </researchPrerequisites>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>120</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="MaidAndroidMod.CompProperties_MaidAppearance"/>
    </comps>
  </ThingDef>

  <!-- ==================== Custom Enter Appearance Station Job ==================== -->
  <JobDef>
    <defName>EnterMaidAppearanceStation</defName>
    <driverClass>MaidAndroidMod.JobDriver_EnterMaidAppearanceStation</driverClass>
    <reportString>Entering appearance customization station.</reportString>
  </JobDef>

  <!-- ==================== Maid Modification Overload (Consciousness Penalty) ==================== -->
  <HediffDef ParentName="ImplantHediffBase">
    <defName>MaidMod_ConsciousnessPenalty</defName>
    <label>modification overload</label>
    <description>The processing cores and power system are overloaded due to excessive performance enhancements without offsetting structural penalties. This limits maximum operational capacity.</description>
    <initialSeverity>0</initialSeverity>
    <minSeverity>0</minSeverity>
    <maxSeverity>10</maxSeverity>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <label>stable</label>
      </li>
      <li>
        <minSeverity>0.9</minSeverity>
        <label>minor overload (level 1)</label>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.10</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>1.9</minSeverity>
        <label>moderate overload (level 2)</label>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.20</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>2.9</minSeverity>
        <label>serious overload (level 3)</label>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.30</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>3.9</minSeverity>
        <label>severe overload (level 4)</label>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.40</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>4.9</minSeverity>
        <label>extreme overload (level 5)</label>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.50</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>5.9</minSeverity>
        <label>critical overload (level 6)</label>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.60</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>6.9</minSeverity>
        <label>dangerous overload (level 7)</label>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.70</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>7.9</minSeverity>
        <label>catastrophic overload (level 8)</label>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.80</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>8.9</minSeverity>
        <label>system breakdown (level 9)</label>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.90</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

