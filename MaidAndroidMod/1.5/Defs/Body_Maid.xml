<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ==================== Bespoke Maid Mechanoid Body Structure ==================== -->
  <BodyDef>
    <defName>Mech_Maid_Body</defName>
    <label>maid mechanoid body</label>
    <corePart>
      <def>MechanicalThorax</def>
      <height>Middle</height>
      <depth>Outside</depth>
      <parts>
        <!-- Dedicated Domestic Head Component -->
        <li>
          <def>MechanicalHead</def>
          <coverage>0.15</coverage>
          <parts>
            <li>
              <def>ArtificialBrain</def>
              <coverage>0.10</coverage>
              <depth>Inside</depth>
            </li>
            <li>
              <def>SightSensor</def>
              <coverage>0.10</coverage>
            </li>
            <li>
              <def>HearingSensor</def>
              <coverage>0.10</coverage>
            </li>
          </parts>
        </li>
        <!-- Left Domestic Actuator (Arm) -->
        <li>
          <def>MechanicalArm</def>
          <customLabel>left domestic actuator</customLabel>
          <coverage>0.15</coverage>
          <parts>
            <li>
              <def>MechanicalHand</def>
              <customLabel>left domestic manipulator</customLabel>
              <coverage>0.30</coverage>
            </li>
          </parts>
        </li>
        <!-- Right Domestic Actuator (Arm) -->
        <li>
          <def>MechanicalArm</def>
          <customLabel>right domestic actuator</customLabel>
          <coverage>0.15</coverage>
          <parts>
            <li>
              <def>MechanicalHand</def>
              <customLabel>right domestic manipulator</customLabel>
              <coverage>0.30</coverage>
            </li>
          </parts>
        </li>
        <!-- Left Locomotion Unit (Leg) -->
        <li>
          <def>MechanicalLeg</def>
          <customLabel>left locomotion unit</customLabel>
          <coverage>0.15</coverage>
        </li>
        <!-- Right Locomotion Unit (Leg) -->
        <li>
          <def>MechanicalLeg</def>
          <customLabel>right locomotion unit</customLabel>
          <coverage>0.15</coverage>
        </li>
      </parts>
    </corePart>
  </BodyDef>

</Defs>
