<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- =====================================================
       HiveKind_Player: 플레이어 시작 폰 (인간형)
       - 시나리오 시작 시 1기 필수 배치
       - 인간 바닐라 텍스처 사용 (녹색 피부 색상 오버레이)
       ===================================================== -->
  <PawnKindDef ParentName="BasePlayerPawnKind">
    <defName>HiveKind_Player</defName>
    <label>hive progenitor</label>
    <race>Hive_PlayerRace</race>
    <xenotypeSet>
      <xenotypeChances>
        <Hive_ProgenitorXenotype>1</Hive_ProgenitorXenotype>
      </xenotypeChances>
    </xenotypeSet>
    <combatPower>50</combatPower>
    <isFighter>true</isFighter>
    <defaultFactionType>PlayerColony</defaultFactionType>
    <minGenerationAge>18</minGenerationAge>
    <maxGenerationAge>40</maxGenerationAge>

     <!-- 스킬: 생존 및 전투에 특화된 초기 설정 -->
