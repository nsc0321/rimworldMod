<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <ThingDef ParentName="Hive_UnitBase">
    <defName>Hive_Unit</defName>
    <label>hive unit</label>
    <description>A generic, undeveloped biological construct of the Hive. It is very weak until mutated with specialized parts.</description>
    <statBases>
      <MoveSpeed>3.0</MoveSpeed>
      <GlobalLearningFactor>0</GlobalLearningFactor>
      <WorkSpeedGlobal>0.5</WorkSpeedGlobal> <!-- Bad at working by default -->
      <ArmorRating_Blunt>0.0</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.0</ArmorRating_Sharp>
    </statBases>
    <race>
      <baseBodySize>1.0</baseBodySize>
      <baseHealthScale>0.5</baseHealthScale> <!-- Very squishy by default -->
    </race>
  </ThingDef>
</Defs>
