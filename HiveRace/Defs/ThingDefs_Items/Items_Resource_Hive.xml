<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <ThingDef ParentName="ResourceBase">
    <defName>Hive_Biomass</defName>
    <label>biomass</label>
    <description>A fleshy, pulsating mass of organic matter generated by the Overmind. It is the primary building material for the Hive.</description>
    <graphicData>
      <!-- Placeholder texture, looks like raw meat -->
      <texPath>Things/Item/Resource/Meat/Meat_Human</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>2.0</MarketValue>
      <Mass>0.05</Mass>
      <MaxHitPoints>50</MaxHitPoints>
      <Flammability>1.0</Flammability>
      <DeteriorationRate>2.0</DeteriorationRate>
    </statBases>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
    <stackLimit>150</stackLimit>
    <comps>
      <li Class="CompProperties_Forbiddable"/>
    </comps>
  </ThingDef>
</Defs>
