<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!-- Toxic Jaw -->
  <HediffDef>
    <defName>HivePart_ToxicJaw</defName>
    <label>toxic jaw</label>
    <description>A mutated jaw that secretes deadly venom. Reduces raw melee damage but adds toxicity.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(100, 255, 100)</defaultLabelColor>
    <isBad>false</isBad>
    <modExtensions>
      <li Class="HiveMod.DefModExtension_HivePart">
        <researchCostEnergy>300</researchCostEnergy>
        <assemblyCostBiomass>20</assemblyCostBiomass>
        <category>Jaw</category>
      </li>
    </modExtensions>
    <stages>
      <li>
        <statOffsets>
          <MeleeHitChance>2</MeleeHitChance>
        </statOffsets>
        <statFactors>
          <MeleeDPS>0.8</MeleeDPS> <!-- Reduced raw damage -->
        </statFactors>
      </li>
    </stages>
    <!-- Toxicity would ideally require a custom Verb/DamageDef or HediffComp, but we leave the framework here -->
  </HediffDef>

  <!-- Mining Jaw -->
  <HediffDef>
    <defName>HivePart_MiningJaw</defName>
    <label>mining jaw</label>
    <description>A heavily reinforced jaw designed to crush rocks, granting the ability to mine effectively.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(200, 150, 50)</defaultLabelColor>
    <isBad>false</isBad>
    <modExtensions>
      <li Class="HiveMod.DefModExtension_HivePart">
        <researchCostEnergy>200</researchCostEnergy>
        <assemblyCostBiomass>15</assemblyCostBiomass>
        <category>Jaw</category>
      </li>
    </modExtensions>
    <stages>
      <li>
        <statOffsets>
          <MiningSpeed>2.0</MiningSpeed> <!-- Massive boost, overcoming base unit's terrible speed -->
          <MiningYield>0.5</MiningYield>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <!-- Heavy Carapace -->
  <HediffDef>
    <defName>HivePart_HeavyCarapace</defName>
    <label>heavy carapace</label>
    <description>Thickened armor plating that drastically increases defense at the cost of mobility.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(150, 150, 150)</defaultLabelColor>
    <isBad>false</isBad>
    <modExtensions>
      <li Class="HiveMod.DefModExtension_HivePart">
        <researchCostEnergy>500</researchCostEnergy>
        <assemblyCostBiomass>30</assemblyCostBiomass>
        <category>Carapace</category>
      </li>
    </modExtensions>
    <stages>
      <li>
        <statOffsets>
          <ArmorRating_Blunt>0.5</ArmorRating_Blunt>
          <ArmorRating_Sharp>0.8</ArmorRating_Sharp>
          <MoveSpeed>-1.0</MoveSpeed>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <!-- Sprinting Legs -->
  <HediffDef>
    <defName>HivePart_SprintingLegs</defName>
    <label>sprinting legs</label>
    <description>Elongated, muscular legs that greatly increase movement speed but are fragile.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(255, 150, 150)</defaultLabelColor>
    <isBad>false</isBad>
    <modExtensions>
      <li Class="HiveMod.DefModExtension_HivePart">
        <researchCostEnergy>400</researchCostEnergy>
        <assemblyCostBiomass>25</assemblyCostBiomass>
        <category>Legs</category>
      </li>
    </modExtensions>
    <stages>
      <li>
        <statOffsets>
          <MoveSpeed>2.5</MoveSpeed>
        </statOffsets>
        <partEfficiencyOffset>-0.2</partEfficiencyOffset> <!-- Simulates fragility -->
      </li>
    </stages>
  </HediffDef>

</Defs>
