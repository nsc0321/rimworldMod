    <displayName>Harmony</displayName>
    <steamWorkshopUrl>steam://url/CommunityFilePage/2009463077</steamWorkshopUrl>
    <downloadUrl>https://github.com/pardeike/HarmonyRimWorld/releases/latest</downloadUrl>
  </li>
  <!-- Biotech expansion is required for GeneDefs -->
  <li>
    <packageId>Ludeon.RimWorld.Biotech</packageId>
    <displayName>Biotech</displayName>
  </li>
  <!-- Big and Small - Framework is required for genes and size scaling -->
  <li>
    <packageId>RedMattis.BetterPrerequisites</packageId>
    <displayName>Big and Small - Framework</displayName>
    <steamWorkshopUrl>steam://url/CommunityFilePage/2925432336</steamWorkshopUrl>
  </li>
</modDependencies>
  <loadAfter>
    <li>brrainz.harmony</li>
    <li>erdelf.HumanoidAlienRaces</li>
