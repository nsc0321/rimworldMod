<?xml version="1.0" encoding="utf-8"?>
<ModMetaData>
  <name>Hive Race</name>
  <author>Player</author>
  <packageId>Player.HiveRace</packageId>
  <supportedVersions>
    <li>1.6</li>
  </supportedVersions>
  <description>
Adds a new playable alien race based on a Zerg-like Hive mechanic. 
Features an Overmind building that spreads creep, generates biomass, and spawns customizable units.
  </description>
